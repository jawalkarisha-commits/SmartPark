# Copy this file to .env, fill values locally, and never commit .env.
# Generate a JWT key with: openssl rand -base64 48
SMARTPARK_JWT_SECRET=replace-with-at-least-32-random-bytes

# MySQL is used by the default profile. Do not point this at a database with
# important records until you have backed it up and explicitly reviewed V4-V8.
SMARTPARK_DB_URL=jdbc:mysql://localhost:3306/smartpark
SMARTPARK_DB_USERNAME=smartpark_app
SMARTPARK_DB_PASSWORD=replace-with-a-database-password

# Optional administrator provisioning. Set reset-password=true to change an
# existing account's password. Remove these values after provisioning.
SMARTPARK_ADMIN_BOOTSTRAP_EMAIL=admin@smartpark01
SMARTPARK_ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
SMARTPARK_ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# Gmail SMTP is free for modest transactional-email use. Enable 2-Step
# Verification on the sender account and create a Google App Password.
SMARTPARK_MAIL_HOST=smtp.gmail.com
SMARTPARK_MAIL_PORT=587
SMARTPARK_MAIL_USERNAME=your-sender@gmail.com
SMARTPARK_MAIL_PASSWORD=replace-with-google-app-password
SMARTPARK_MAIL_AUTH=true
SMARTPARK_MAIL_STARTTLS=true
SMARTPARK_MAIL_FROM=your-sender@gmail.com
SMARTPARK_RESET_URL=http://127.0.0.1:5173/forgot-password

# Razorpay test credentials; live mode must only be enabled after provider setup.
SMARTPARK_RAZORPAY_MODE=test
SMARTPARK_RAZORPAY_KEY_ID=rzp_test_replace_me
SMARTPARK_RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
SMARTPARK_RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

SMARTPARK_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public OpenStreetMap Nominatim usage requires an identifying contact address.
SMARTPARK_GEOCODER_CONTACT=replace-with-an-operator-contact-email
